{
  "name": "clientes_por_olt",
  "version": "1.0.0",
  "private": true,
  "description": "Cruce de clientes en Smart OLT y Grafana (Cloudflare Pages + D1)",
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB",
    "deploy": "wrangler pages deploy public",
    "db:create": "wrangler d1 create clientes_por_olt",
    "db:schema": "wrangler d1 execute clientes_por_olt --remote --file=./schema.sql",
    "db:schema:local": "wrangler d1 execute clientes_por_olt --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}